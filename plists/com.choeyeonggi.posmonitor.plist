<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.choeyeonggi.posmonitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/.venv/bin/python</string>
    <string>-m</string>
    <string>src.monitor</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <!-- 5분 주기 fire. weekday/공휴일/정규장 시간/보유 0건은 코드에서 즉시 skip -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/logs/monitor.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/logs/monitor.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key><string>ko_KR.UTF-8</string>
    <key>KIS_MODE</key><string>paper</string>
    <key>KIS_ENABLE_TRADING</key><string>true</string>
  </dict>
</dict>
</plist>
